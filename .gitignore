# Dependencies
node_modules/

# Package artifacts
*.tgz
*.tar.gz

# Test and build output
coverage/
dist/
build/
.cache/
.tmp/
tmp/

test/

# Local runtime state
.showdar.json
.showdar/

# Project-local agent installations and code index
/.claude/
/.cursor/
/.opencode/
/.codeatlas/

# Generated evaluation results; retain datasets, manifests, and audits
/evals/*-first-run.json

# Local secrets and environment files
.env
.env.*
!.env.example

# Logs and crash dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid

# Operating system and editor files
.DS_Store
.AppleDouble
.LSOverride
.idea/
.vscode/
*.swp
*.swo

# Local working/feature plans are intentionally not part of the published source repo.
# Keep public reference guides tracked while excluding local docs and plans.
docs/*
!docs/REFERENCE.md
!docs/WORKFLOWS.md
.agents
