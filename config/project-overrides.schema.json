{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Showdar project overrides (.showdar/overrides.json)",
  "description": "User-owned project extension configuration. Built-in workflow policy and built-in profile definitions are protected and MUST NOT appear here as semantic overrides.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "skillDescriptions": {
      "type": "object",
      "patternProperties": {
        "^showdar-[a-z][a-z0-9-]*$": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "skillDomains": {
      "type": "object",
      "patternProperties": {
        "^showdar-[a-z][a-z0-9-]*$": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "minLength": 2, "maxLength": 40 }
      },
      "additionalProperties": false
    },
    "workflowPolicy": {
      "type": "object",
      "description": "Custom workflows only. Built-in showdar-* workflow IDs are rejected.",
      "patternProperties": {
        "^[a-z][a-z0-9]*-[a-z][a-z0-9-]*$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stages": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^showdar-[a-z][a-z0-9-]*$" }
            },
            "skipRules": { "type": "object" },
            "requiredStages": {
              "type": "array",
              "items": { "type": "string", "pattern": "^showdar-[a-z][a-z0-9-]*$" }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "guidance": {
      "type": "object",
      "description": "Separate advisory text. MUST NOT replace SKILL.md semantics or claim authority.",
      "patternProperties": {
        "^showdar-[a-z][a-z0-9-]*$": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "object",
      "description": "New project-owned profiles only. MUST NOT mutate built-in profile definitions.",
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  }
}
