# Model-free tool runtime. Built only in an explicitly provisioned Docker environment.
# The base image is content-addressed, not a mutable tag.
FROM node@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
RUN apk add --no-cache git
LABEL org.showdar.purpose="behavioral-eval-offline-tool-runtime"
